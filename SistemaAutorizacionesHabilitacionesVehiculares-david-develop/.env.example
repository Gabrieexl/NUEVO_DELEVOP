# Variables de entorno para desarrollo local
# Copiar este archivo a .env y configurar los valores

# Django
SECRET_KEY=django-insecure-cambiar-en-produccion-con-clave-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://tudominio.com

# Database (Usar DATABASE_URL para producción/Coolify)
DATABASE_URL=postgres://user:password@host:port/dbname
# O configuración manual:
DB_NAME=drtc_autorizaciones
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Celery / Redis (Usar REDIS_URL para producción/Coolify)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (para desarrollo usar console, en producción SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DRTC <noreply@drtc.gob.pe>

# Logging
DJANGO_LOG_LEVEL=INFO
